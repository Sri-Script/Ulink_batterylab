rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function hasLegacySiProfile() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in
          ['si', 'system_integrator', 'system integrator'];
    }
    function isSi() {
      return signedIn() &&
        (request.auth.token.role == 'si' ||
         request.auth.token.role == 'system_integrator' ||
         request.auth.token.systemIntegrator == true ||
         hasLegacySiProfile());
    }
    function companyAssigned(companyId) {
      return isSi() && request.auth.uid in
        get(/databases/$(database)/documents/companies/$(companyId)).data.systemIntegratorIds;
    }

    match /companies/{companyId} {
      allow get, list: if isSi() && request.auth.uid in resource.data.systemIntegratorIds;
      allow write: if false;
    }

    // Every authenticated user may read only their own legacy profile so the
    // login route can distinguish a normal user from an SI without scanning
    // user records. Profile writes remain server-controlled.
    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /ucodes/{ucode} {
      allow get, list: if isSi() && resource.data.assignedSiUid == request.auth.uid &&
        (resource.data.status == 'available' ||
         (resource.data.status == 'flashed' && companyAssigned(resource.data.companyId)) ||
         resource.data.status == 'reserving' ||
         resource.data.status == 'pending_verification' ||
         resource.data.status == 'recovery_required');
      allow update: if isSi() && resource.data.assignedSiUid == request.auth.uid &&
        ((resource.data.status == 'available' && resource.data.companyId == null &&
          request.resource.data.status == 'reserving' &&
          request.resource.data.reservationId is string &&
          request.resource.data.companyId == null) ||
         (resource.data.status == 'reserving' && resource.data.companyId == null &&
          resource.data.reservationId == request.resource.data.reservationId &&
          (request.resource.data.status == 'available' ||
           request.resource.data.status == 'pending_verification' ||
           request.resource.data.status == 'recovery_required') &&
          request.resource.data.companyId == null));
      allow create, delete: if false;
    }

    match /provisioningEvents/{eventId} {
      allow create: if isSi() && request.resource.data.siUid == request.auth.uid &&
        request.resource.data.type == 'ucode_write_acknowledged' &&
        request.resource.data.status == 'acknowledged';
      allow get, list: if isSi() && resource.data.siUid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
